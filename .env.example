# Publishing / promotion stay in demo mode. Douyin OAuth is configured separately.
ALPHA_MODE=demo
# Default: SQLite persisted under .data/. Set to use PostgreSQL instead.
# DATABASE_URL=postgresql://user:password@localhost:5432/juzhenliu
# MATRIX_DATA_DIR=D:/matrix-data
# MATRIX_ASSISTANT_PORT=37211
# PORT=3000
# Relative MATRIX_DATA_DIR paths are resolved from the repository root.

# 0.11: Real Douyin account authorization. Never use NEXT_PUBLIC_ for secrets.
# Use an approved website app or an app with applicable test permissions.
# MATRIX_OWNER_PASSWORD=at-least-24-random-characters
# DOUYIN_CLIENT_KEY=
# DOUYIN_CLIENT_SECRET=
# DOUYIN_REDIRECT_URI=https://your-domain.example/api/douyin/callback
# DOUYIN_TOKEN_KEY=64-hex-characters-from-32-random-bytes
