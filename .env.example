# Publishing / promotion stay in demo mode. Douyin OAuth is configured separately.
ALPHA_MODE=demo
# Default: SQLite persisted under .data/. Set to use PostgreSQL instead.
# DATABASE_URL=postgresql://user:password@localhost:5432/juzhenliu
# MATRIX_DATA_DIR=D:/matrix-data
# MATRIX_ASSISTANT_PORT=37211
# PORT=3000
# Relative MATRIX_DATA_DIR paths are resolved from the repository root.

# 0.11: Real Douyin account authorization. Never use NEXT_PUBLIC_ for secrets.
# Use an approved website app or an app with applicable test permissions.
# MATRIX_OWNER_PASSWORD=at-least-24-random-characters
# DOUYIN_CLIENT_KEY=
# DOUYIN_CLIENT_SECRET=
# DOUYIN_REDIRECT_URI=https://your-domain.example/api/douyin/callback
# DOUYIN_TOKEN_KEY=64-hex-characters-from-32-random-bytes

# Server-side video analytics at /videos (does not need Douyin OAuth or Edge).
# TIKHUB_API_KEY=your-tikhub-api-key
# MATRIX_OWNER_PASSWORD=at-least-24-random-characters
# Required for production, exactly one HTTPS origin without trailing slash.
# MATRIX_PUBLIC_ORIGIN=https://your-domain.example
# Maximum NEW video/account queries per Asia/Shanghai day; cache reads do not count.
# Video queries use up to 2 endpoints; account lookups use up to 3.
# Failed attempts also consume quota. Confirming an account preview makes no API call.
# MATRIX_VIDEO_DAILY_LIMIT=100

# Personal multi-account publishing (/publishing), separate from demo publishing.
# Source integration only; real Douyin acceptance and engine installation pending.
# First release supports single-host SQLite only. See docs/PUBLISHING.md.
MATRIX_PUBLISHING_ENABLED=0
# Login/check can run without enabling video publishing or installing Python upstream.
MATRIX_PUBLISHING_LOGIN_ENABLED=0
# Installed browser channel for login/check: msedge, chrome, chromium
MATRIX_LOGIN_BROWSER_CHANNEL=msedge
# MATRIX_PUBLISHING_KEY=<64-hex independent random encryption key>
# MATRIX_PUBLISHING_PYTHON=/absolute/path/to/venv/bin/python
# MATRIX_SAU_ROOT=/absolute/path/to/reviewed/social-auto-upload
