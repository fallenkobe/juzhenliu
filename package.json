{
  "name": "juzhenliu",
  "version": "0.11.0-alpha.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev apps/web --hostname 127.0.0.1 --port 3000",
    "dev:worker": "tsx apps/worker/index.ts",
    "build": "next build apps/web",
    "start": "next start apps/web --hostname 127.0.0.1 --port 3000",
    "preview": "node scripts/dev.mjs --production",
    "serve:videos": "node scripts/serve-videos.mjs",
    "worker": "tsx apps/worker/index.ts",
    "assistant": "tsx apps/assistant/index.ts",
    "db:init": "tsx scripts/init-db.ts",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/business.test.ts tests/douyin-auth.test.ts tests/assistant.test.ts tests/video.test.ts tests/accounts.test.ts tests/works.test.ts tests/images.test.ts tests/image-analysis.test.ts tests/video-snapshots.test.ts tests/video-heat.test.ts tests/publishing.test.ts",
    "test:e2e": "playwright test",
    "publisher": "tsx apps/publisher/index.ts",
    "test:publishing": "tsx --test tests/publishing.test.ts"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pg": "^8.16.3",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
