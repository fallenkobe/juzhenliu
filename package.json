{
  "name": "juzhenliu",
  "version": "0.0.1-alpha.1",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev apps/web --hostname 127.0.0.1 --port 3000",
    "dev:worker": "tsx apps/worker/index.ts",
    "build": "next build apps/web",
    "start": "next start apps/web --hostname 127.0.0.1 --port 3000",
    "preview": "node scripts/dev.mjs --production",
    "worker": "tsx apps/worker/index.ts",
    "db:init": "tsx scripts/init-db.ts",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/business.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.61.0",
    "zod": "4.6.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.20.6",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/pg": "^8.15.5",
    "@playwright/test": "^1.56.1"
  }
}
